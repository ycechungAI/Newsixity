# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite
/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-lock.yaml

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# database
/data/
/data_backup_*/
database.sqlite
*.db
*.db-shm
*.db-wal

# graphify (codebase analysis artifacts)
/graphify-out/

# typescript
*.tsbuildinfo
.venv/

# pyinstaller (frozen backend build output)
/backend/build/
/backend/dist/

# tauri (rust build output + generated schemas + copied-in backend resource)
/src-tauri/target/
/src-tauri/gen/
/src-tauri/resources/newsixity-backend/

# claude code
.claude/
