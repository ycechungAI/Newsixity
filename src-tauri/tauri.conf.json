{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Newsixity",
  "version": "0.1.0",
  "identifier": "com.newsixity.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["resources/newsixity-backend"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
